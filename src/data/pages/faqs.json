   "rows": [
    {
     "rowClass": "accordion jsc-accordion jsc-collapsible-row",
     "detailsId": "Details-mg_2_1-template--22799925477655__faq",
     "question": "Berapa minimal pemesanan?",
     "contentClass": "collapsible__content accordion__content rte jsc-collapsible__content",
     "contentId": "Accordion-mg_2_1-template--22799925477655__faq",
     "answerHtml": "<p>Minimal pemesanan umumnya 50 pcs per produk. Jumlah minimal setiap produk tercantum di halaman produk.</p>"
    },
    {
     "rowClass": "accordion jsc-accordion jsc-collapsible-row",
     "detailsId": "Details-mg_2_2-template--22799925477655__faq",
     "question": "Apa itu halaman redaksi?",
     "contentClass": "collapsible__content accordion__content rte jsc-collapsible__content",
     "contentId": "Accordion-mg_2_2-template--22799925477655__faq",
     "answerHtml": "<p>Halaman redaksi adalah halaman personal di dalam buku, misalnya foto dan data almarhum/almarhumah atau kata pengantar dari keluarga. Setiap pesanan mendapat 5 halaman redaksi gratis: 1 halaman foto dan 4 halaman teks.</p>"
    },
    {
     "rowClass": "accordion jsc-accordion jsc-collapsible-row",
     "detailsId": "Details-mg_2_3-template--22799925477655__faq",
     "question": "Bagaimana proses desainnya?",
     "contentClass": "collapsible__content accordion__content rte jsc-collapsible__content",
     "contentId": "Accordion-mg_2_3-template--22799925477655__faq",
     "answerHtml": "<p>Setelah pesanan dan data personalisasi kami terima, tim kami menyiapkan desain untuk Anda periksa. Produksi dimulai setelah desain Anda setujui.</p>"
    },
    {
     "rowClass": "accordion jsc-accordion jsc-collapsible-row",
     "detailsId": "Details-mg_2_4-template--22799925477655__faq",
     "question": "Saya ingin bertanya sebelum memesan. Ke mana saya menghubungi?",
     "contentClass": "collapsible__content accordion__content rte jsc-collapsible__content",
     "contentId": "Accordion-mg_2_4-template--22799925477655__faq",
     "answerHtml": "<p>Hubungi admin kami melalui WhatsApp <a href=\"https://wa.me/6281947949888\">+62 819 4794 9888</a> atau email <a href=\"mailto:manisgrafika@gmail.com\">manisgrafika@gmail.com</a>.</p>"
    }
   ]
