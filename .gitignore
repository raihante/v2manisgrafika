# Mega-menu promotion images (3-15 MB each, requested by the source at width=2500). Reproducible with
# `node scripts/build-header-data.mjs && node scripts/build-shell-css.mjs && node scripts/download-header-assets.mjs`.
public/assets/source/header/*Hamburger*.webp
public/assets/source/header/*HAMBURGER*.webp

# Collection grid promotion banner, desktop (18 MB, requested by the source at width=2344). Reproducible with
# `node scripts/build-collection-data.mjs new-in && node scripts/download-collection-assets.mjs new-in`.
public/assets/source/collection/*_Collection_Grid_Desktop.webp
# /collections card banners at 960w and 1280w (1-4 MB each). Reproducible with
# `node scripts/build-collection-list-data.mjs && node scripts/download-collection-assets.mjs _index`.
public/assets/source/collections/*_960x_crop_center.*
public/assets/source/collections/*_1280x_crop_center.*
# /pages/contact-us header GIF at 1600w (3.9 MB). Reproducible with
# `node scripts/build-contact-data.mjs && node scripts/download-collection-assets.mjs _contact`.
public/assets/source/pages/CONTCT-US-NEW_1600x500_crop_center.gif
# /pages/about-us Shogun backdrop GIFs (6-7 MB originals). Reproducible with
